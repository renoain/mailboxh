# Repo Mailboxh. Flutter ada di frontend/, Laravel di backend/.
# Root hanya berisi dokumentasi dan aturan.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/frontend/build/
/frontend/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/frontend/android/app/debug
/frontend/android/app/profile
/frontend/android/app/release

# Widget Preview related
.widget_preview/

# Backend Laravel
/backend/vendor/
/backend/node_modules/
/backend/public/storage/
/backend/storage/*.key
/backend/storage/framework/cache/data/
/backend/storage/framework/sessions/
/backend/storage/framework/views/
/backend/storage/logs/
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# Secret
.env
.env.*
!.env.example
*.pem
*.key
auth.json
